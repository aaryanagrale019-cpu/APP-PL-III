def knapsack_bottom_up(weights, values, capacity):
    n = len(weights)

    dp = [[0 for j in range(capacity + 1)]
          for i in range(n + 1)]

    for i in range(1, n + 1):
        for w in range(capacity + 1):
            if weights[i - 1] <= w:
                dp[i][w] = max(
                    values[i - 1] + dp[i - 1][w - weights[i - 1]],
                    dp[i - 1][w]
                )
            else:
                dp[i][w] = dp[i - 1][w]

    return dp[n][capacity]


def knapsack_top_down(weights, values, capacity):
    n = len(weights)
    memo = {}

    def solve(i, w):
        if i == 0 or w == 0:
            return 0

        if (i, w) in memo:
            return memo[(i, w)]

        if weights[i - 1] <= w:
            memo[(i, w)] = max(
                values[i - 1] + solve(i - 1, w - weights[i - 1]),
                solve(i - 1, w)
            )
        else:
            memo[(i, w)] = solve(i - 1, w)

        return memo[(i, w)]

    return solve(n, capacity)


weights = [2, 3, 4, 5]
values = [3, 4, 5, 6]
capacity = 5

print("Weights:", weights)
print("Values:", values)
print("Knapsack Capacity:", capacity)

print("\nBottom-Up Approach:")
print("Maximum Value:", knapsack_bottom_up(weights, values, capacity))

print("\nTop-Down Approach:")
print("Maximum Value:", knapsack_top_down(weights, values, capacity))
